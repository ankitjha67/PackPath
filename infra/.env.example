# Copy to `.env` next to docker-compose.yml and fill in.
# `docker compose up -d` reads this automatically.

# Use "production" on a public server (the app refuses insecure defaults there).
ENVIRONMENT=local

# CHANGE THIS on any real deployment — sign your own tokens.
JWT_SECRET=change-me-in-prod

# SMS OTP via MSG91. Leave blank to run in dev-OTP mode (the code comes back
# in the API response — fine for testing, not for production).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=PACKPT
