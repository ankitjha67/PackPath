# Copy to `.env` next to docker-compose.yml and fill in.
# `docker compose up -d` reads this automatically.

# Use "production" on a public server (the app refuses insecure defaults there).
ENVIRONMENT=local

# Set true only when running behind a reverse proxy (nginx/caddy) so the rate
# limiter keys on the real client IP (X-Forwarded-For) instead of the proxy's.
TRUST_PROXY=false

# CHANGE THIS on any real deployment — sign your own tokens.
JWT_SECRET=change-me-in-prod

# SMS OTP via MSG91. Leave blank to run in dev-OTP mode (the code comes back
# in the API response — fine for testing, not for production).
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=PACKPT

# Maps (optional). Any one key enables routing/ETA + that provider's tiles;
# with none set the app uses free OpenStreetMap tiles and OSRM routing.
# Ola is India-tuned (vector basemap + directions) and preferred when set.
OLA_MAPS_API_KEY=
# MAPBOX_SERVER_TOKEN=
# GOOGLE_MAPS_API_KEY=
# MAPPLS_REST_KEY=
